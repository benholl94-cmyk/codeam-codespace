# rollout-shield — operator-controlled environment
# Copy to .env (which is gitignored) and fill in. NEVER commit .env.
#
# To use: source .env before running tools, or pass via:
#   ROLLOUT_SHIELD_STATE=/secure/path rollout-shield status

# Path to encrypted-state unlock key (defaults to .audit/.owner_unlock).
# Generate with: python3 tools/secure_state.py --init
# ROLLOUT_SHIELD_UNLOCK=/secure/path/.owner_unlock

# Where to write rollout-shield state (config, claims, alerts, health).
# Default: .rollout-shield (relative to repo). Prefer an absolute path outside
# any synced/cloud-mounted directory for true zero-leak.
# ROLLOUT_SHIELD_STATE=/var/lib/rollout-shield/state

# Where to write the audit log. Default: .audit. For zero-leak, place on an
# encrypted volume and set mode 0700.
# ROLLOUT_SHIELD_AUDIT=/var/lib/rollout-shield/audit

# Optional: webhook URL for alert delivery. Only used by `rollout-shield alerter`.
# Without this, alerts are written to the alerts/ dir but never POSTed anywhere.
# ROLLOUT_SHIELD_WEBHOOK_URL=

# Safeup retention (snapshots kept before rotation). Default: 10.
# SAFEUP_KEEP=20

# Owner-only access control for the audit log. When set, owner_log.py requires
# this token to be present in the operator's session before reading sensitive
# entries. Leave unset during local development.
# ROLLOUT_SHIELD_OWNER_TOKEN=
