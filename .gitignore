
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Workspace-local build/output artifacts (scripts/export-state.sh output)
dist/

# rollout-shield runtime state (CLI + monitor + dashboard write here)
.rollout-shield/

# Python bytecode (CLI package)
__pycache__/
*.pyc
*.pyo

.safeups/

# zero-leak security infra: never commit
.audit/
.audit/audit.jsonl
.audit/.owner_unlock
.env
.env.*
!.env.example
*.pem
*.key
*.p12
private/
secrets/

# Python packaging build artifacts (created by `pip install -e .` or
# `python -m build`). The package source itself is tracked.
*.egg-info/
build/
dist/

# Android Studio / Gradle / IntelliJ artifacts (created by build-on-termux.sh
# or by opening android-app/ in Android Studio). The android-app/ source tree
# itself IS tracked; only the build outputs are excluded.
android-app/.gradle/
android-app/build/
android-app/app/build/
android-app/local.properties
android-app/build.log
android-app/captures/
android-app/.idea/
*.iml
.kotlin/

# judgement-debug-workflow dead-room (isolated sink for non-User instructions)
.claude/skills/judgement-debug-workflow/deadroom/
